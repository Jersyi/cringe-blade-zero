# Source only: everything is ignored except the build inputs listed below.
*
!*/
!.gitignore
!README.md
!CHANGELOG.md
!CMakeLists.txt
!build.ps1
!*.cpp
!*.h
!*.asm
!*.def
!docs/title.jpg
!docs/donate.jpg
!docs/BUILD.md
!docs/GAME_UPDATES.md
!docs/PAK_WORKFLOW.md
!scripts/update_port.py
!scripts/make_mount_pak.py
!scripts/requirements-port.txt
!installer/install.ps1
!installer/Install.bat
!src/env_check/known_exes.cmake
!src/env_check/known_exes.h.in

# Build output, release ZIPs and local notes / scripts / archives stay out of the repository.
build/
build_*/
dist/
local/

# Players' chain files (combos\*.combo next to version.dll) are personal data: never in the repository or the ZIP.
combos/
*.combo
